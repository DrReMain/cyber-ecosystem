{
  "$schema": "../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "deploy",
  "root": "deploy",
  "targets": {
    "db:start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/db/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/db/postgresql.yaml -f deploy/k8s/base/db/redis.yaml",
          "kubectl rollout status statefulset/postgresql -n db --timeout=300s",
          "kubectl rollout status statefulset/redis -n db --timeout=300s"
        ],
        "parallel": false
      }
    },
    "db:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace db --ignore-not-found"
      }
    },
    "storage:start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/storage/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/storage/seaweedfs.yaml",
          "kubectl rollout status statefulset/seaweedfs -n storage --timeout=300s"
        ],
        "parallel": false
      }
    },
    "storage:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace storage --ignore-not-found"
      }
    },
    "mq:start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/mq/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/mq/nats.yaml",
          "kubectl rollout status statefulset/nats -n mq --timeout=300s"
        ],
        "parallel": false
      }
    },
    "mq:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace mq --ignore-not-found"
      }
    },
    "realtime:start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/realtime/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/realtime/centrifugo.yaml",
          "kubectl rollout status deployment/centrifugo -n realtime --timeout=300s"
        ],
        "parallel": false
      }
    },
    "realtime:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace realtime --ignore-not-found"
      }
    },
    "media:start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/media/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/media/livekit.yaml",
          "kubectl rollout status deployment/livekit -n media --timeout=300s"
        ],
        "parallel": false
      }
    },
    "media:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace media --ignore-not-found"
      }
    },
    "observability:start": {
      "executor": "nx:run-commands",
      "dependsOn": ["db:start"],
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f deploy/k8s/base/observability/namespace.yaml",
          "kubectl apply -f deploy/k8s/base/observability/clickhouse.yaml",
          "kubectl wait pod -n observability -l app=clickhouse --for=condition=ready --timeout=600s",
          "kubectl wait pod -n observability -l app=zookeeper --for=condition=ready --timeout=600s",
          "kubectl apply -f deploy/k8s/base/observability/signoz-migrator.yaml",
          "kubectl wait job -n observability signoz-schema-migrator --for=condition=complete --timeout=600s",
          "kubectl apply -f deploy/k8s/base/observability/signoz.yaml",
          "kubectl wait deployment -n observability signoz-otel-collector signoz --for=condition=available --timeout=600s",
          "kubectl apply -f deploy/k8s/base/observability/glitchtip.yaml",
          "kubectl wait job -n observability glitchtip-setup --for=condition=complete --timeout=600s",
          "kubectl wait deployment -n observability glitchtip --for=condition=available --timeout=600s"
        ],
        "parallel": false
      }
    },
    "observability:stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "kubectl delete namespace observability --ignore-not-found"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["db:start", "storage:start", "mq:start"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "echo '=== Core services started (observability/realtime/media are opt-in) ===' && kubectl get pods -A -o wide | grep -v kube-system"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "observability:stop",
        "media:stop",
        "realtime:stop",
        "mq:stop",
        "storage:stop",
        "db:stop"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "echo '=== All services stopped ==='"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl get pods -A -o wide | grep -v kube-system",
          "kubectl get svc -A -o wide | grep -v kube-system"
        ],
        "parallel": false
      }
    }
  }
}
