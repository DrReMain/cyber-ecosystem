{
  "$schema": "../../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "@cyber-ecosystem/shared-theme",
  "root": "shared-ts/theme",
  "projectType": "library",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome check"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome format"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec tsc --noEmit"
      }
    }
  }
}
