{
  "$schema": "../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "tools",
  "root": "tools",
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "go install github.com/fullstorydev/grpcurl/cmd/grpcurl@v1.9.4",
          "go install github.com/bufbuild/buf/cmd/buf@v1.73.0",
          "go mod download",
          "buf dep update",
          "pnpm install"
        ],
        "parallel": false
      }
    },
    "buf:format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "buf format -w"
      }
    },
    "go:fmt": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/go-fmt.mjs"
      }
    },
    "go:lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["go tool golangci-lint run ./..."]
      }
    },
    "go:format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["go tool golangci-lint run --fix ./..."]
      }
    },
    "go:test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["go test -count=1 ./..."]
      }
    },
    "gates:drift": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/gates-drift.mjs"
      }
    },
    "gates:quality": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/gates-quality.mjs"
      }
    },
    "gates:specs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/gates-specs.mjs"
      }
    },
    "gates:push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "node .nx/nxw.js run tools:gates:drift",
          "node .nx/nxw.js run tools:gates:quality",
          "node .nx/nxw.js run tools:gates:specs"
        ],
        "parallel": false
      }
    }
  }
}
