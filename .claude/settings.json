{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl *)",
      "Bash(grpcurl *)",
      "Bash(./nx *)",
      "Bash(pnpm *)"
    ],
    "deny": [
      "Bash(nohup)",
      "Bash(kill)",
      "Bash(node)",
      "Bash(node *)",
      "Bash(npm)",
      "Bash(npm *)",
      "Bash(npx)",
      "Bash(npx *)",
      "Bash(yarn)",
      "Bash(yarn *)",
      "Bash(go run)",
      "Bash(go run *)",
      "Bash(golangci-lint *)",
      "Bash(vitest *)"
    ]
  }
}
