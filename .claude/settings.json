{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl *)",
      "Bash(grpcurl *)",
      "Bash(./nx *)",
      "Bash(pnpm *)"
    ],
    "deny": [
      "Bash(nohup)",
      "Bash(kill)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm exec *)",
      "Bash(go run *)",
      "Bash(go tool *)",
      "Bash(golangci-lint *)",
      "Bash(vitest *)"
    ]
  }
}
