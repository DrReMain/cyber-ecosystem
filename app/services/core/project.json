{
  "$schema": "../../../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "core",
  "root": "app/services/core",
  "projectType": "application",
  "targets": {
    "proto:conf": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "buf generate --template internal/conf/buf.gen.conf.yaml --path internal/conf"
      }
    },
    "generate:ent": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "go generate ./internal/ent/..."
      }
    },
    "generate:wire": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "go generate ./cmd/app/..."
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": ["proto:generate", "proto:conf", "generate:ent", "generate:wire"],
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["go mod tidy"],
        "parallel": false
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "go tool kratos run"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/bin"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "go build -ldflags \"-X main.Version=$(git describe --tags --always)\" -o ./bin/ ./..."
      }
    },
    "migrate:diff": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "atlas migrate diff \"${NAME:-changes}\" --dir \"file://internal/ent/migrate/migrations\" --to \"ent://internal/ent/schema\" --dev-url \"${ATLAS_DEVDB:-postgres://postgres:postgres@localhost:5432/atlas_dev?sslmode=disable}\""
      }
    },
    "migrate:apply": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "atlas migrate apply --dir \"file://internal/ent/migrate/migrations\" --url \"${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/core?sslmode=disable}\""
      }
    },
    "migrate:validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "atlas migrate validate --dir \"file://internal/ent/migrate/migrations\""
      }
    }
  }
}
