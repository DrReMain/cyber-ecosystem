{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["../../../biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!**/*.gen.ts",
      "!**/*.gen.tsx",
      "!**/*.gen.d.ts",
      "!**/dist",
      "!**/.output",
      "!**/coverage",
      "!**/src/paraglide"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noLeakedRender": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "noArrayIndexKey": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 200, "skipBlankLines": true }
        },
        "useArrowFunction": "error",
        "useSimplifiedLogicExpression": "error"
      },
      "style": {
        "useConsistentTypeDefinitions": "error",
        "noParameterAssign": "error",
        "useExportType": "error",
        "useImportType": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error",
        "noBlankTarget": "error"
      },
      "nursery": {
        "useSortedClasses": "error",
        "noFloatingPromises": "error",
        "noComponentHookFactories": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "noUnnecessaryTemplateExpression": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/features/modules/test/games/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#/features/auth/**", "#/services/**", "#/stores/**"],
                    "message": "game runtimes must not import auth, services, or stores (plugin contract admission law)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
