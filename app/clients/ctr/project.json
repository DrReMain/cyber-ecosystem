{
  "$schema": "../../../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "@cyber-ecosystem/ctr",
  "root": "app/clients/ctr",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vite dev --host"
      }
    },
    "dev-up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/devserver.cjs up --project @cyber-ecosystem/ctr"
      }
    },
    "dev-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/devserver.cjs down --project @cyber-ecosystem/ctr"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vite build"
      }
    },
    "build:analyze": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vite build --mode analyze"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vite preview --host"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec vitest run --passWithNoTests"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome format"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome lint"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec biome check"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec tsc --noEmit"
      }
    },
    "image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker build -f app/clients/ctr/Dockerfile --build-arg NPM_REGISTRY=\"$(pnpm config get registry)\" -t cyber-ecosystem/ctr:local ."
      }
    }
  }
}
