{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "zh-CN",
  "locales": ["zh-CN", "en-US"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/common/{locale}.json",
      "./messages/home/{locale}.json",
      "./messages/match/{locale}.json",
      "./messages/login/{locale}.json",
      "./messages/profile/{locale}.json",
      "./messages/not-found/{locale}.json",
      "./messages/error/{locale}.json",
      "./messages/agreement/{locale}.json",
      "./messages/age-required/{locale}.json",
      "./messages/test/{locale}.json",
      "./messages/report/{locale}.json",
      "./messages/security/{locale}.json",
      "./messages/pay/{locale}.json"
    ]
  }
}
