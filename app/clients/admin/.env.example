# API base URLs (SSR internal — Node SSR connects to backends directly, bypassing traefik)
# Server-side only; NOT exposed to the browser bundle.
# dev: local services | prod: k3s internal service DNS (e.g. http://core-connect:13001)
HTTP_API_URL=http://localhost:11001
CONNECT_API_URL=http://localhost:13001

# Client-side URLs (VITE_ prefix required by Vite — exposed to browser bundle)
# dev: vite proxy (see vite.config server.proxy) | prod: public traefik host
VITE_SITE_URL=http://localhost:3000
VITE_CONNECT_API_URL=http://localhost:3000/connect
VITE_HTTP_API_URL=http://localhost:3000/http
